{
  "name": "@snyk/github-codeowners",
  "version": "1.0.0",
  "description": "Parse and match GitHub CODEOWNERS files - specification-faithful library and CLI tool",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "cli": "ts-node --transpile-only src/cli.ts",
    "cli:dist": "tsc && node dist/cli.js",
    "test": "jest",
    "pretest:int": "rm -rf tests/scratch",
    "test:int": "env JEST_JUNIT_OUTPUT_DIR=./tests/reports/int jest --testMatch  **/*.test.int.ts --ci"
  },
  "author": "snyk.io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/raysihto-playground-25/github-codeowners"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ignore": "^5.3.2",
    "p-map": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "uuid": "^11.0.3"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "bin": "dist/cli.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "github",
    "codeowners",
    "ownership",
    "code-review",
    "git",
    "parser",
    "matcher"
  ]
}
